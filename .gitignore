/experiments/**/results/**/*.npz
/experiments/**/results/**/*.pt
# cia_eurosat_scaling produces 36 IN/OUT trajectories (18 per group), each with its own
# ~17.5MB evaluation.json -- ~630MB total, decided against committing given the volume
# (unlike results/contest_at_scale/eurosat/results/accuracy/'s single accuracy-sweep evaluation.json per combo, which
# was small enough in isolation to keep). Result/report JSONs (cia_in.json, cia_out.json,
# per-trajectory .json result files, .pt checkpoints already covered above) are unaffected.
/results/contest_at_scale/eurosat/results/attack/*.evaluation.json
# Raw full-output logs, not the small progress/summary logs -- matches the established
# convention (checked directly against master: results/48client_scaling/,
# results/cia_client_scaling/, etc. commit sweep_progress.log-style summaries but never a raw
# stdout capture). 27-28MB each for the CIA groups, 9.3MB for the accuracy sweep.
/results/contest_at_scale/eurosat/results/accuracy/sweep_stdout.log
/results/contest_at_scale/eurosat/results/attack/stdout_*.log
# cifar100_scaling evaluation JSONs persist per-class ROC curves across 100 classes,
# producing 230-400MB files that blow past GitHub's 100MB push limit.
/results/contest_at_scale/cifar100/results/accuracy/*.evaluation.json
# Same 100-class model/blowup as above, for the CIA IN/OUT trajectories against it.
/results/contest_at_scale/cifar100/results/attack/*.evaluation.json
# auc_frontier produces one evaluation.json per stage per run (~4.8MB each, EuroSAT
# alone hit 16 in the pilot curve) across up to 16 curves x ~17 stages x 2 runs -- same
# volume concern as the cia_eurosat_scaling/cifar100_scaling exclusions above.
/results/contest_at_scale/auc_frontier/results/**/*.evaluation.json
final_model.pt
*.fab
.DS_Store
docs/
.claude
.idea/
.worktrees/
.superpowers
.colab/
/tmp
# dataset_vs_model: per-run evaluation.json is 17-23MB (per-class ROC curves); same
# volume convention as auc_frontier above. Run JSONs keep the metrics analyze.py reads.
/results/cia_frontier/dataset_vs_model/results/**/*.evaluation.json
